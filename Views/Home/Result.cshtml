@model MedicalSymptomTriage.Models.SymptomPredictionModel

@{
    ViewData["Title"] = "Prediction Result";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="text-center mb-4">

                <h1 class="display-6 fw-bold">
                    Prediction Result
                </h1>

                <p class="text-muted">
                    The ML.NET model has processed your symptoms.
                </p>

            </div>

            <div class="card shadow-sm border-0">

                <div class="card-body p-5 text-center">

                    <h5 class="text-muted mb-3">
                        Suggested Specialist Category
                    </h5>

                    <h2 class="fw-bold text-secondary mb-4">
                        @Model.PredictedLabel
                    </h2>

                    <p class="text-muted">
                        This result is generated by the trained ML.NET
                        classification model.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-primary mt-3">
                        Check Another Symptom
                    </a>

                </div>

            </div>

            <div class="alert alert-warning mt-4">

                <strong>Important:</strong>
                This application is for educational and demonstration
                purposes only. It does not provide a medical diagnosis
                and should not replace advice from a qualified healthcare
                professional.

            </div>

        </div>

    </div>

</div>